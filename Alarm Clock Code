def play_alarm_sound():
    """
    Play a system beep. Works on Windows, macOS, and most Linux.
    On some systems it may only print a bell character.
    """
    try:
        # Windows
        if sys.platform == "win32":
            import winsound
            for _ in range(6):
                winsound.Beep(1000, 300)
                time.sleep(0.15)
        else:
            # macOS / Linux
            for _ in range(6):
                print("\a", end="", flush=True)
                time.sleep(0.2)
    except Exception:
        print("\a" * 5)


def load_alarms():
    """Load saved alarms from JSON file. Returns a list of dicts."""
    if not os.path.exists(ALARM_FILE):
        return []
    try:
        with open(ALARM_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, list) else []
    except Exception:
        return []


def save_alarms(alarms):
    """Save the list of alarms to JSON file."""
    try:
        with open(ALARM_FILE, "w", encoding="utf-8") as f:
            json.dump(alarms, f, indent=2)
    except Exception as e:
        print(f"Could not save alarms: {e}")


def format_time_12h(hour, minute):
    """Return a nice 12-hour string like '07:30 AM'."""
    period = "AM" if hour < 12 else "PM"
    display_hour = hour % 12
    if display_hour == 0:
        display_hour = 12
    return f"{display_hour:02d}:{minute:02d} {period}"


