    # -----------------------------------------------------------------------
    # Clock & Alarm Logic
    # -----------------------------------------------------------------------
    def update_clock(self):
        """Update the big clock every second."""
        now = datetime.now()
        if self.use_24h.get():
            time_str = now.strftime("%H:%M:%S")
        else:
            time_str = now.strftime("%I:%M:%S %p")
        self.time_label.config(text=time_str)
        self.date_label.config(text=now.strftime("%A, %B %d, %Y"))
        self.root.after(1000, self.update_clock)

    def check_alarms(self):
        """Check every second if any alarm should ring."""
        if not self.ringing:
            now = datetime.now()
            for alarm in self.alarms:
                if not alarm.get("enabled", True):
                    continue
                if now.hour == alarm["hour"] and now.minute == alarm["minute"] and now.second < 2:
                    self.trigger_alarm(alarm)
                    break
        self.root.after(CHECK_INTERVAL, self.check_alarms)

    def trigger_alarm(self, alarm):
        """Start ringing an alarm."""
        self.ringing = True
        self.current_alarm = alarm
        label = alarm.get("label", "Alarm")
        self.alarm_label.config(text=f"🔔 {label}")
        self.alarm_frame.pack(pady=10)
        self.root.lift()
        self.root.attributes("-topmost", True)
        self.root.after(2000, lambda: self.root.attributes("-topmost", False))

        # Play sound in a background thread so the GUI stays responsive
        threading.Thread(target=play_alarm_sound, daemon=True).start()

        # Flash the window title
        self.flash_title()

    def flash_title(self):
        """Visual flash effect while alarm is ringing."""
        if not self.ringing:
            self.root.title("Python Alarm Clock")
            return
        current = self.root.title()
        new_title = "🔔 ALARM! 🔔" if "ALARM" not in current else "Python Alarm Clock"
        self.root.title(new_title)
        self.root.after(500, self.flash_title)

    # -----------------------------------------------------------------------
    # Alarm Management
    # -----------------------------------------------------------------------
    def add_alarm(self):
        """Add a new alarm from the input fields."""
        try:
            hour = int(self.hour_var.get())
            minute = int(self.minute_var.get())
            label = self.label_var.get().strip() or "Alarm"

            if not (0 <= hour <= 23 and 0 <= minute <= 59):
                raise ValueError

            # Avoid exact duplicates
            for a in self.alarms:
                if a["hour"] == hour and a["minute"] == minute and a["label"] == label:
                    messagebox.showinfo("Duplicate", "This alarm already exists.")
                    return

            new_alarm = {
                "hour": hour,
                "minute": minute,
                "label": label,
                "enabled": True
            }
            self.alarms.append(new_alarm)
            save_alarms(self.alarms)
            self.refresh_alarm_list()
            messagebox.showinfo("Success", f"Alarm set for {format_time_12h(hour, minute)}")

        except ValueError:
            messagebox.showerror("Invalid Time", "Please enter a valid hour (0-23) and minute (0-59).")

    def delete_selected(self):
        """Delete the alarm selected in the list."""
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("No Selection", "Please select an alarm to delete.")
            return

        index = self.tree.index(selected[0])
        if 0 <= index < len(self.alarms):
            del self.alarms[index]
            save_alarms(self.alarms)
            self.refresh_alarm_list()

    def refresh_alarm_list(self):
        """Redraw the alarm list."""
        for item in self.tree.get_children():
            self.tree.delete(item)

        # Sort by time
        sorted_alarms = sorted(self.alarms, key=lambda a: (a["hour"], a["minute"]))
        self.alarms = sorted_alarms

        for alarm in self.alarms:
            if self.use_24h.get():
                time_str = f"{alarm['hour']:02d}:{alarm['minute']:02d}"
            else:
                time_str = format_time_12h(alarm["hour"], alarm["minute"])
            status = "ON" if alarm.get("enabled", True) else "OFF"
            self.tree.insert("", "end", values=(time_str, alarm["label"], status))

    def snooze(self):
        """Snooze the current alarm for SNOOZE_MINUTES."""
        if not self.current_alarm:
            return
        now = datetime.now()
        snooze_time = now + timedelta(minutes=SNOOZE_MINUTES)
        # Update the current alarm to the new time
        self.current_alarm["hour"] = snooze_time.hour
        self.current_alarm["minute"] = snooze_time.minute
        save_alarms(self.alarms)
        self.refresh_alarm_list()
        self.dismiss(show_message=False)
        messagebox.showinfo("Snoozed", f"Alarm snoozed for {SNOOZE_MINUTES} minutes.")

    def dismiss(self, show_message=True):
        """Stop the ringing alarm."""
        self.ringing = False
        self.current_alarm = None
        self.alarm_frame.pack_forget()
        self.root.title("Python Alarm Clock")
        if show_message:
            messagebox.showinfo("Dismissed", "Alarm dismissed.")